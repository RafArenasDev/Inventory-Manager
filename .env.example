APP_NAME="Inventory Manager"
# Ruta pública (dentro de public/) al logo de los correos del sistema —
# cambiar por instancia/negocio (ej. "/logo-moto-repuestos.png").
APP_LOGO="/logo-icon.png"
APP_VERSION=1.0.0
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://inventory.local

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

BUSINESS_NAME="Inventory Manager"
BUSINESS_NIT="900123456-7"
BUSINESS_PHONE="3001234567"
BUSINESS_EMAIL="contacto@inventorymanager.com"
BUSINESS_ADDRESS="Cra 45 #12-30, Bogotá, Cundinamarca"
# Valor de la UVT del año gravable vigente (DIAN la fija cada diciembre para
# el año siguiente) — de acá se derivan los topes de abajo. Vigente 2026:
# $52.374 (Resolución 000238 del 15/12/2025). Actualizar cada enero.
BUSINESS_UVT_VALUE=52374
# Tope de venta a "Consumidor Final" (documento 222222222222) en UVT — 5 UVT
# por defecto (mismo límite del tiquete P.O.S. tradicional).
BUSINESS_CONSUMIDOR_FINAL_LIMIT_UVT=5
# Ingresos brutos anuales (UVT) a partir de los cuales la DIAN exige
# facturación electrónica obligatoria — 3.500 UVT por defecto. Solo dispara
# un aviso informativo en el Dashboard, nunca bloquea nada.
BUSINESS_ANNUAL_INVOICING_THRESHOLD_UVT=3500

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# 630 min = exactamente 8:00am-6:30pm (10h 30min).
SESSION_LIFETIME=630
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Tiempo real (php artisan reverb:start debe estar corriendo aparte).
# Generar credenciales propias con: php artisan reverb:install
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# PHP -> Reverb (interno, loopback, sin TLS).
REVERB_SERVER_HOST=127.0.0.1
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Navegador -> Reverb, vía el mismo nginx/HTTPS del sitio (ruta /app
# proxeada al puerto interno) — ajustar el host al dominio real del sitio.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=inventory-manager.test
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
